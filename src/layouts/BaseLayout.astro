---
import Navbar, { type ThemeLogoSchedule } from '@components/common/Navbar';
import TopBanner, { type BannerConfig, type BannerItem } from '@components/common/TopBanner';
import Hero from '@components/common/Hero';
import HeroCarousel, {
  type CarouselSlide,
  type CarouselConfig,
  type ThemeCarouselSchedule,
} from '@components/common/HeroCarousel';
import Footer from '@components/common/Footer';
import BackToTop from '@components/common/BackToTop';
import { getCollection, getEntry } from 'astro:content';
import { SITE_METADATA, DEFAULT_THEME, type ThemeConfig } from '@src/consts';
import {
  formatThemeCssVariables,
  isThemeActive,
  mergeThemeColors,
  parseThemeDate,
  serializeThemeDate,
  type ScheduledThemeCarousel,
  type ScheduledThemeColors,
  type ScheduledThemeLogo,
} from '@src/utils/theme';
import type { ImageMetadata } from 'astro';

export type { ThemeConfig };

import '@styles/main.scss';
import '@fontsource-variable/open-sans';
import '@fontsource-variable/montserrat';

interface Props {
  title?: string;
  lead?: string;
  description?: string;
  background?: string | ImageMetadata;
  heroHeight?: 'short' | 'tall';
  overlay?: boolean;
  carousel?: boolean | string | CarouselSlide[] | CarouselConfig;
  banner?: boolean | string | BannerItem[] | BannerConfig;
  theme?: string;
  documentStyle?: string;
  lang?: 'fi' | 'en';
  slug?: string;
  translation?: string;
  robots?: string;
  contentMaxWidth?: string;
}

const {
  title = SITE_METADATA.title.fi,
  lead,
  description,
  background,
  heroHeight = 'short',
  overlay,
  carousel = false,
  banner = true,
  theme,
  documentStyle = '',
  lang = 'fi',
  slug = '',
  translation,
  robots,
  contentMaxWidth = '900px',
} = Astro.props;

let bannerResolved: BannerConfig | null = null;
if (banner !== false) {
  let bannerSource: BannerConfig | null = null;

  if (Array.isArray(banner)) {
    bannerSource = { enabled: true, items: banner };
  } else if (typeof banner === 'object' && banner !== null) {
    bannerSource = banner;
  } else {
    const entryName = typeof banner === 'string' ? banner : 'banner';
    bannerSource = (await getEntry('banner', entryName))?.data as BannerConfig | null;
  }

  if (
    bannerSource &&
    bannerSource.enabled !== false &&
    Array.isArray(bannerSource.items) &&
    bannerSource.items.length > 0
  ) {
    const localizedItems = bannerSource.items.map((item) => {
      const text =
        typeof item.text === 'object' && item.text !== null
          ? (item.text as Record<string, string>)[lang] ?? (item.text as Record<string, string>).fi ?? ''
          : item.text ?? '';

      let link = item.link;
      if (typeof item.link === 'object' && item.link !== null) {
        const linkText =
          typeof item.link.text === 'object' && item.link.text !== null
            ? (item.link.text as Record<string, string>)[lang] ?? (item.link.text as Record<string, string>).fi
            : item.link.text;
        link = { ...item.link, text: linkText };
      }

      return {
        ...item,
        text,
        link,
      };
    });

    bannerResolved = {
      enabled: bannerSource.enabled,
      items: localizedItems,
    };
  }
}

const rawSvgs = import.meta.glob<string>('/src/assets/**/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

function resolveLogo(pathOrSvg: string): string | null {
  if (!pathOrSvg) return null;
  const trimmed = pathOrSvg.trim();
  if (trimmed.startsWith('<svg') || trimmed.startsWith('<?xml')) {
    return trimmed;
  }
  const normalized = trimmed
    .replace(/^@assets\//, '/src/assets/')
    .replace(/^@src\//, '/src/')
    .replace(/^\/?assets\//, '/src/assets/');

  if (rawSvgs[normalized]) {
    return rawSvgs[normalized];
  }

  const filename = trimmed.split('/').pop()?.toLowerCase();
  for (const [key, content] of Object.entries(rawSvgs)) {
    if (key === normalized || (filename && key.toLowerCase().endsWith('/' + filename))) {
      return content;
    }
  }

  return trimmed;
}

const now = new Date();
const EXPIRED_BUFFER_MS = 24 * 60 * 60 * 1000;

let activeThemeData: ThemeConfig | null = null;
let buildActiveThemeId: string | null = null;
let relevantScheduledThemes: Array<{ id: string; data: ThemeConfig }> = [];

if (theme && typeof theme === 'string') {
  const requestedEntry = await getEntry('theme', theme);
  if (requestedEntry) {
    activeThemeData = (requestedEntry.data as ThemeConfig) ?? null;
    buildActiveThemeId = requestedEntry.id;
  }
} else {
  const allThemes = await getCollection('theme');
  const activeScheduledThemes = allThemes.filter((entry) => {
    return isThemeActive((entry.data as ThemeConfig) ?? {}, now);
  });

  if (activeScheduledThemes.length === 1) {
    activeThemeData = (activeScheduledThemes[0].data as ThemeConfig) ?? null;
    buildActiveThemeId = activeScheduledThemes[0].id;
  } else if (activeScheduledThemes.length > 1) {
    console.warn(
      `[Theme] Scheduling conflict: ${activeScheduledThemes.length} themes active (${activeScheduledThemes.map((t) => t.id).join(', ')}). Using default theme.`
    );
    activeThemeData = null;
  }

  // Keep scheduled themes that are currently active or upcoming (with a 24h timezone buffer)
  relevantScheduledThemes = allThemes
    .map((entry) => ({ id: entry.id, data: (entry.data as ThemeConfig) ?? {} }))
    .filter(({ data }) => {
      const start = parseThemeDate(data.startDate);
      const end = parseThemeDate(data.endDate);
      if (!start && !end) return false;
      if (end && end.getTime() < now.getTime() - EXPIRED_BUFFER_MS) return false;
      return true;
    });
}

const defaultThemeCssVariables = formatThemeCssVariables(mergeThemeColors(null));
const themeCssVariables = formatThemeCssVariables(mergeThemeColors(activeThemeData?.colors));

const clientColorSchedule: ScheduledThemeColors[] | null =
  !theme && relevantScheduledThemes.length > 0
    ? relevantScheduledThemes.map(({ id, data }) => ({
        id,
        startDate: serializeThemeDate(data.startDate),
        endDate: serializeThemeDate(data.endDate),
        cssVariables: formatThemeCssVariables(mergeThemeColors(data.colors)),
      }))
    : null;

const themeCarouselName =
  activeThemeData?.carousel !== undefined && activeThemeData?.carousel !== null
    ? activeThemeData.carousel
    : DEFAULT_THEME.carousel;

const defaultLogo = resolveLogo(DEFAULT_THEME.logo);
const rawLogo =
  typeof activeThemeData?.logo === 'string' && activeThemeData.logo.trim()
    ? activeThemeData.logo.trim()
    : DEFAULT_THEME.logo;
const themeLogo = resolveLogo(rawLogo);

let themeLogoSchedule: ThemeLogoSchedule | null = null;
if (!theme && relevantScheduledThemes.length > 0 && defaultLogo) {
  const logosMap: Record<string, string> = { default: defaultLogo };
  const scheduledLogoThemes: ScheduledThemeLogo[] = relevantScheduledThemes.map(({ id, data }) => {
    const resolved = typeof data.logo === 'string' && data.logo.trim() ? resolveLogo(data.logo.trim()) : defaultLogo;
    let logoKey = 'default';
    if (resolved && resolved !== defaultLogo) {
      logosMap[id] = resolved;
      logoKey = id;
    }
    return {
      id,
      startDate: serializeThemeDate(data.startDate),
      endDate: serializeThemeDate(data.endDate),
      logoKey,
    };
  });

  if (Object.keys(logosMap).length > 1) {
    const initialEntry = buildActiveThemeId ? scheduledLogoThemes.find((t) => t.id === buildActiveThemeId) : undefined;
    themeLogoSchedule = {
      logos: logosMap,
      defaultLogoKey: 'default',
      initialLogoKey: initialEntry?.logoKey ?? 'default',
      themes: scheduledLogoThemes,
    };
  }
}

const assetImages = carousel
  ? import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif,svg}', {
      eager: true,
    })
  : {};

async function resolveCarouselConfig(
  carouselInput: string | CarouselSlide[] | CarouselConfig
): Promise<CarouselConfig | null> {
  let source: CarouselConfig | undefined;
  if (typeof carouselInput === 'string') {
    let carouselEntry = await getEntry('carousel', carouselInput);
    if (!carouselEntry && carouselInput !== 'default') {
      carouselEntry = await getEntry('carousel', 'default');
    }
    source = carouselEntry?.data as CarouselConfig | undefined;
  } else if (!Array.isArray(carouselInput)) {
    source = carouselInput;
  }

  const rawItems = (Array.isArray(carouselInput) ? carouselInput : source?.items ?? []) as CarouselSlide[];
  if (rawItems.length === 0) return null;

  const items = rawItems.map((item) => {
    const slide = { ...item };

    if (typeof slide.title === 'object' && slide.title !== null) {
      slide.title = (slide.title as Record<string, string>)[lang] ?? (slide.title as Record<string, string>).fi;
    }
    if (typeof slide.lead === 'object' && slide.lead !== null) {
      slide.lead = (slide.lead as Record<string, string>)[lang] ?? (slide.lead as Record<string, string>).fi;
    }

    if (typeof slide.src === 'string') {
      const normalized = slide.src
        .replace(/^@assets\//, '/src/assets/')
        .replace(/^@src\//, '/src/')
        .replace(/^\/?images\//, '/src/assets/images/');

      for (const [key, asset] of Object.entries(assetImages)) {
        if (
          key === normalized ||
          key.endsWith(slide.src.replace(/^@assets\//, '')) ||
          key.endsWith('/' + slide.src.split('/').pop())
        ) {
          slide.src = asset.default.src;
          break;
        }
      }
    }

    if (slide.src && typeof slide.src !== 'string') {
      const extracted =
        (slide.src as { src?: string })?.src ??
        (slide.src as { default?: { src?: string } })?.default?.src ??
        (slide.src as { default?: string })?.default;
      slide.src = typeof extracted === 'string' ? extracted : String(slide.src);
    }

    return slide;
  });

  return {
    items,
    autoplay: typeof source?.autoplay === 'boolean' ? source.autoplay : true,
    interval: typeof source?.interval === 'number' ? source.interval : 6000,
    overlay: typeof overlay === 'boolean' ? overlay : typeof source?.overlay === 'boolean' ? source.overlay : true,
  };
}

let carouselResolved: CarouselConfig | null = null;
if (carousel && (typeof carousel !== 'boolean' || themeCarouselName !== false)) {
  const resolvedCarouselName = typeof themeCarouselName === 'string' ? themeCarouselName : 'default';
  const carouselInput = typeof carousel === 'boolean' ? resolvedCarouselName : carousel;
  carouselResolved = await resolveCarouselConfig(carouselInput);
}

let themeCarouselSchedule: ThemeCarouselSchedule | null = null;
if (carousel === true && !theme && relevantScheduledThemes.length > 0) {
  const defaultCarouselConfig = await resolveCarouselConfig(DEFAULT_THEME.carousel);
  const carouselsMap: Record<string, CarouselConfig | null> = { default: defaultCarouselConfig };
  const scheduledCarouselThemes: ScheduledThemeCarousel[] = [];

  for (const { id, data } of relevantScheduledThemes) {
    const entryCarousel =
      data.carousel !== undefined && data.carousel !== null ? data.carousel : DEFAULT_THEME.carousel;
    let carouselKey = 'default';

    if (entryCarousel === false) {
      carouselsMap[id] = null;
      carouselKey = id;
    } else if (typeof entryCarousel === 'string' && entryCarousel !== DEFAULT_THEME.carousel) {
      carouselsMap[id] = await resolveCarouselConfig(entryCarousel);
      carouselKey = id;
    }

    scheduledCarouselThemes.push({
      id,
      startDate: serializeThemeDate(data.startDate),
      endDate: serializeThemeDate(data.endDate),
      carouselKey,
    });
  }

  if (Object.keys(carouselsMap).length > 1) {
    const initialEntry = buildActiveThemeId
      ? scheduledCarouselThemes.find((t) => t.id === buildActiveThemeId)
      : undefined;
    themeCarouselSchedule = {
      carousels: carouselsMap,
      defaultCarouselKey: 'default',
      initialCarouselKey: initialEntry?.carouselKey ?? 'default',
      themes: scheduledCarouselThemes,
    };
  }
}

const naviEntry = await getEntry('navigation', 'navi');
const naviData = naviEntry?.data ?? [];

const sponsorsCollection = await getCollection('sponsors');
const sponsors = sponsorsCollection[0]?.data ?? [];

const fullTitle = `${title && title !== SITE_METADATA.title[lang] ? title + ' | ' : ''}${SITE_METADATA.title[lang]}`;
const metaDescription = description ?? lead ?? SITE_METADATA.description[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {robots && <meta name="robots" content={robots} />}

    <!-- Material Symbols & Icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=open_in_new"
    />
    <style>
      .material-symbols-outlined {
        font-variation-settings:
          'FILL' 0,
          'wght' 400,
          'GRAD' 0,
          'opsz' 24;
      }
    </style>
    <!-- Theme CSS Variables -->
    <style id="theme-colors" set:html={`:root { ${themeCssVariables} }`}></style>
    <script is:inline define:vars={{ clientColorSchedule, defaultThemeCssVariables }}>
      if (clientColorSchedule && clientColorSchedule.length > 0) {
        (function () {
          function parseDate(v) {
            if (!v) return null;
            const s = String(v).trim();
            if (!s) return null;
            const m = /^(\d{4})[-/](\d{2})[-/](\d{2})$/.exec(s);
            if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]), 0, 0, 0, 0);
            const norm = s.indexOf(' ') !== -1 && s.indexOf('T') === -1 ? s.replace(' ', 'T') : s;
            const d = new Date(norm);
            return Number.isNaN(d.getTime()) ? null : d;
          }
          function isActive(t, nowMs) {
            const start = parseDate(t.startDate);
            const end = parseDate(t.endDate);
            if (!start && !end) return false;
            if (start && nowMs < start.getTime()) return false;
            if (end && nowMs > end.getTime()) return false;
            return true;
          }
          function applyTheme() {
            const nowMs = Date.now();
            const active = clientColorSchedule.filter((t) => isActive(t, nowMs));
            const css = active.length === 1 ? active[0].cssVariables : defaultThemeCssVariables;
            const styleEl = document.getElementById('theme-colors');
            if (styleEl) styleEl.textContent = `:root { ${css} }`;
          }
          let timer = null;
          function scheduleNext() {
            if (timer) {
              clearTimeout(timer);
              timer = null;
            }
            const nowMs = Date.now();
            let minDelay = Infinity;
            for (const entry of clientColorSchedule) {
              const s = parseDate(entry.startDate);
              const e = parseDate(entry.endDate);
              if (s && s.getTime() > nowMs) minDelay = Math.min(minDelay, s.getTime() - nowMs);
              if (e && e.getTime() + 1 > nowMs) minDelay = Math.min(minDelay, e.getTime() + 1 - nowMs);
            }
            if (minDelay > 0 && minDelay <= 2147483647) {
              timer = setTimeout(() => {
                applyTheme();
                scheduleNext();
              }, minDelay);
            }
          }
          applyTheme();
          scheduleNext();
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden) {
              applyTheme();
              scheduleNext();
            }
          });
        })();
      }
    </script>
  </head>
  <body>
    <div id="layout-container">
      {
        bannerResolved && Array.isArray(bannerResolved.items) && bannerResolved.items.length > 0 && (
          <TopBanner client:only="react" {...bannerResolved} />
        )
      }
      <Navbar
        client:load
        lang={lang}
        slug={slug}
        translation={translation}
        naviData={naviData}
        logo={themeLogo ?? undefined}
        themeLogoSchedule={themeLogoSchedule ?? undefined}
      />
      {
        carouselResolved && carouselResolved.items.length > 0 ? (
          <HeroCarousel client:load {...carouselResolved} themeCarouselSchedule={themeCarouselSchedule ?? undefined} />
        ) : (
          <Hero title={title} lead={lead} background={background} heroHeight={heroHeight} />
        )
      }
      <main id="layout-content" class={documentStyle}>
        <slot />
      </main>
      <Footer lang={lang} sponsors={sponsors} />
      <BackToTop client:load lang={lang} />
    </div>
  </body>
</html>

<style lang="scss" define:vars={{ contentMaxWidth }}>
  #layout-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    align-items: center;
    & > * {
      width: 100%;
    }
  }

  #layout-content {
    flex-grow: 1;
    background: $natural-white;

    width: 100%;
    max-width: var(--contentMaxWidth);
    margin-inline: auto;

    margin-bottom: 5rem;
    padding-inline: 1.5rem;
  }
</style>
