---
import BaseLayout from '@layouts/BaseLayout.astro';
import heroPic from '@assets/images/Lakkien_jako_2016-100.jpg';

const description =
  'Killan jäsenenä saat oikeuden osallistua killan tapahtumiin ja käyttää kiltahuonetta sekä pääsyn killan sähköpostilistoille. \
Lisäksi varsinaisena jäsenenä saat äänioikeuden kiltakokouksissa.';

const lang = 'fi';
const slug = '/guild/membership';
---

<BaseLayout
  title="Jäsenyys"
  background={heroPic}
  heroHeight="tall"
  lead="Killan jäsenenä saat oikeuden osallistua killan tapahtumiin ja käyttää kiltahuonetta sekä pääsyn killan sähköpostilistoille. Lisäksi varsinaisena jäsenenä saat äänioikeuden kiltakokouksissa."
  description={description}
  lang={lang}
  slug={slug}
>
  <a
    class="center-block rounded-button vertically-aligned-button"
    target="_blank"
    href="https://id.as.fi"
    rel="noreferrer"
  >
    ASID
    <span class="material-symbols-outlined" style="margin-left: 0.3em;">open_in_new</span>
  </a>

  <p>
    Killan jäsenyyttä haetaan ja jäsenmaksut maksetaan ASID-sivustolla jäsenyystyypistä riippumatta. Samalla sivustolla
    killan jäsenet voivat tarkastella ja päivittää omia killan jäsenrekisteriin tallennetuja tietoja.
    Sisäänkirjautuminen on mahdollista sähköpostiosoitteella. Varsinaisen jäsenyyden hakeminen edellyttää
    <code>@aalto.fi</code>-sähköpostiosoitteen vahvistamista tilin asetuksissa.
  </p>

  <h2>Varsinainen jäsenyys</h2>
  <p>
    Killan varsinaiseksi jäseneksi voidaan hyväksyä kaikki AYY:n jäsenistöön kuuluvat henkilöt. Killan jäsenenä saat
    äänioikeuden kiltakokouksissa, oikeuden osallistua killan tapahtumiin ja käyttää kiltahuonetta sekä pääsyn killan
    sähköpostilistoille. Lisätietoa killan jäsenyydestä löytyy killan{' '}
    <a href="/guild/docs/guild-rules"> säännöistä </a>{' '}
    luvusta 2.
  </p>

  <h2>Ulkojäsenyys</h2>
  <p>
    Killan ulkojäseneksi voidaan hyväksyä killan toiminnasta kiinnostunut henkilö, jota ei voida hyväksyä varsinaiseksi
    tai vanhaksi jäseneksi. Ulkojäsenyyden ja varsinaisen jäsenyyden jäsenmaksu on sama.
  </p>

  <h2>Vanha jäsenyys</h2>
  <p>
    Killan vanhaksi jäseneksi voi hakea henkilö, joka on ollut killan varsinainen jäsen, mutta ei ole enää AYY:n jäsen.
    Vanhan jäsenen ei tarvitse maksaa jäsenmaksua.
  </p>
</BaseLayout>

<style>
  .center-block {
    margin: 2rem auto;
  }
</style>
