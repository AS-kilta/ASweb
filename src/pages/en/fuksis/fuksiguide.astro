---
import BaseLayout from '@layouts/BaseLayout.astro';

const description = 'This guide contains everything you need to know about the university, studying and student life';
const lead = 'This guide contains everything you need to know about the university, studying and student life';
---

<BaseLayout title="DSD Fuksi guide 2026" lead={lead} description={description} lang="en" slug="/en/fuksis/fuksiguide">
  <div style={{ width: '100%' }}>
    <a
      style={{ marginBlock: '1rem' }}
      class="rounded-button"
      target="_blank"
      href="https://drive.google.com/file/d/1f2PD3DL2nru0hANHUF2utD7wM2PKqv1G"
      rel="noreferrer"
    >
      Download PDF
    </a>
    <iframe
      src="https://drive.google.com/file/d/1f2PD3DL2nru0hANHUF2utD7wM2PKqv1G/preview"
      width="100%"
      height="800"
      allow="autoplay"></iframe>
  </div>
</BaseLayout>
