---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import timetable from '@src/assets/images/M_orientaatio.png';

const description = "The orientation week schedule for Master's fuksis";
---

<BaseLayout
  title="Master's Orientation week"
  heroHeight="short"
  description={description}
  lang="en"
  slug="/en/fuksis/orientationweek-mint"
>
  <h2 id="orientaatioviikon-aikataulu"></h2>

  <div class="image-container">
    <p>Orientation week is a hectic week with lots to do and explore!</p>
    <p>
      Here is the orientation week schedule as of now, we will try to update this to the best of our ability during
      summer.
    </p>
    <Image class="centered-image" src={timetable} alt="timetable" />

    <p>
      More information about the programme organized by ELEC can be found in the: <a
        href="https://events.aalto.fi/en/3X3IKxA7/orientation-for-new-masters-students-in-the-school-of-electrical-engineering-4a3bQtmNrx/sessions?t=202608251730"
        >ELEC orientation schedule</a
      >
    </p>
  </div>
  <style>
    .centered-image {
      display: block;
      margin-left: auto;
      margin-right: auto;
      max-width: 100%;
      max-height: 90%;
      height: auto;
    }
  </style>
</BaseLayout>
