---
import BaseLayout from '@layouts/BaseLayout.astro';

const description =
  'Fuksiopas sisältää kaiken, mitä sinun tarvitsee tietää tulevasta opiskelijaelämästä ja AS-killasta.';
const lead = 'Fuksiopas sisältää kaiken, mitä sinun tarvitsee tietää tulevasta opiskelijaelämästä ja AS-killasta.';
---

<BaseLayout
  title="Maistereiden sekä vaihto-opiskelijoiden Fuksiopas – Syksy 2026"
  lead={lead}
  description={description}
  lang="fi"
  slug="/fuksis/fuksiguide-mint"
>
  <div style={{ width: '100%' }}>
    <iframe
      src="https://drive.google.com/file/d/1ELRwNVKv6Z22-nM8Fn3xXRuDrB9a7gQW/preview"
      width="100%"
      height="800"
      allow="autoplay"></iframe>
  </div>
</BaseLayout>
