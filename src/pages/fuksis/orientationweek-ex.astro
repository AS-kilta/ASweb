---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import timetable from '@src/assets/images/EX_orientaatio.png';

const description = 'Orientaatioviikon aikataulu vaihto-opiskelijoille';
---

<BaseLayout
  title="Vaihto-opiskelijoiden orientaatioviikko"
  description={description}
  lang="fi"
  slug="/fuksis/orientationweek-ex"
>
  <h2 id="orientaatioviikon-aikataulu"></h2>

  <div class="image-container">
    <p>Orientaatioviikko on hektistä aikaa, tekemistä on paljon!</p>
    <p>Tässä orientaatioviikon aikataulu, päivittelemme tätä parhaamme mukaan kesän aikana.</p>
    <Image class="centered-image" src={timetable} alt="timetable" />
  </div>
  <style>
    .centered-image {
      display: block;
      margin-left: auto;
      margin-right: auto;
      max-width: 100%;
      max-height: 90%;
      height: auto;
    }
  </style>
</BaseLayout>
